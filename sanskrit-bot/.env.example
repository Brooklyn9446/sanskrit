# Sanskrit & Bhagavad Gita Learning Bot Configuration

# LLM Provider selection: 'gemini', 'openai', or 'groq'
LLM_PROVIDER=gemini

# Specific model name (leave blank to use recommended provider defaults)
# Gemini default: gemini-2.5-flash
# OpenAI default: gpt-4o-mini
# Groq default: llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash

# Provider API Keys (fill the one matching your LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
