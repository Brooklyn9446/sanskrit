FROM jenkins/jenkins:lts

USER root

# Install Python 3, venv, and Docker CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Add jenkins user to docker group to allow running docker commands
RUN usermod -aG docker jenkins

USER jenkins